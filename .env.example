# Copy to .env and adjust. All values are optional.
# RMS_HOST=127.0.0.1        # use 0.0.0.0 to expose on your local network
# RMS_PORT=8000
# RMS_DATA_DIR=./data       # SQLite db, backups, logo and secret key live here
# RMS_DATABASE_URL=         # defaults to sqlite:///<data_dir>/rms.db
# RMS_SECRET_KEY=           # auto-generated into <data_dir>/secret.key when empty
# RMS_SECURE_COOKIES=false  # set true when served over HTTPS

# Copy to .env and adjust. Everything is optional.

# --- Server ---
# RMS_HOST=127.0.0.1        # use 0.0.0.0 to expose on your local network
# RMS_PORT=8000
# RMS_DATA_DIR=./data       # SQLite db, backups, logo and secret key live here
# RMS_DATABASE_URL=         # defaults to sqlite:///<data_dir>/rms.db
# RMS_SECRET_KEY=           # auto-generated into <data_dir>/secret.key when empty
# RMS_SECURE_COOKIES=false  # set true when served over HTTPS

# --- Email (SMTP) ---
# RMS_SMTP_HOST=smtp.gmail.com
# RMS_SMTP_PORT=587
# RMS_SMTP_SECURITY=starttls   # starttls | ssl | none
# RMS_SMTP_USER=you@gmail.com
# RMS_SMTP_PASSWORD=           # an app password, not your normal one
# RMS_SMTP_FROM=you@gmail.com  # shown as the sender

# --- SMS and WhatsApp (Twilio) ---
# RMS_TWILIO_SID=
# RMS_TWILIO_TOKEN=
# RMS_TWILIO_SMS_FROM=+15550001111        # a Twilio number that can send SMS
# RMS_TWILIO_WHATSAPP_FROM=+14155238886   # your WhatsApp sender (the Twilio sandbox number to start)
